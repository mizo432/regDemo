<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<VBox spacing="12.0" xmlns:fx="http://javafx.com/fxml" fx:controller="com.github.mizo432.reg.ui.controller.InventoryController" stylesheets="@../css/material-design.css">
    <padding>
        <Insets bottom="16.0" left="16.0" right="16.0" top="16.0" />
    </padding>

    <Label text="在庫管理" styleClass="header-label" />

    <VBox spacing="10.0" styleClass="card">
        <padding>
            <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
        </padding>
        <HBox spacing="10.0">
            <TextField fx:id="searchField" promptText="商品名で検索" HBox.hgrow="ALWAYS" />
            <Button text="検索" onAction="#handleSearch" />
            <Button text="全件表示" onAction="#handleShowAll" styleClass="outlined" />
        </HBox>
    </VBox>

    <TableView fx:id="inventoryTable" VBox.vgrow="ALWAYS">
        <columns>
            <TableColumn fx:id="barcodeColumn" text="バーコード" prefWidth="120" />
            <TableColumn fx:id="nameColumn" text="名称" prefWidth="200" />
            <TableColumn fx:id="quantityColumn" text="在庫数" prefWidth="80" />
            <TableColumn fx:id="reservedColumn" text="予約数" prefWidth="80" />
            <TableColumn fx:id="availableColumn" text="利用可能" prefWidth="80" />
        </columns>
    </TableView>

    <HBox spacing="10.0">
        <Button text="編集" onAction="#handleEditInventory" />
        <Button text="更新" onAction="#handleRefresh" styleClass="outlined" />
    </HBox>
</VBox>
